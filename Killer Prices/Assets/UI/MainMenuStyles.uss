/* Main Container Background */
.main-menu-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 10, 20, 0.9); /* Dark Blue/Black tint */
}

/* Glassmorphism Panel for Buttons */
.menu-panel {
    width: 400px;
    padding: 40px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    align-items: stretch;
}

/* Game Title */
.game-title {
    font-size: 60px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 50px;
    text-shadow: 0px 4px 10px rgba(0, 200, 255, 0.5); /* Neon glow */
}

/* Menu Buttons */
.menu-button {
    height: 60px;
    margin-bottom: 20px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 0;
    border-radius: 10px;
    color: white;
    font-size: 24px;
    transition: 0.2s;
}

.menu-button:hover {
    background-color: rgba(0, 200, 255, 0.8); /* Cyan hover */
    scale: 1.05;
}

.menu-button:active {
    background-color: rgba(0, 150, 200, 0.8);
    scale: 0.95;
}
