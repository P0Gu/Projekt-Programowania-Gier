.section-header {
    font-size: 24px;
    color: rgba(255, 255, 255, 0.7);
    -unity-font-style: bold;
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    padding-bottom: 5px;
}

/* Slider Styling */
.settings-slider {
    margin-bottom: 15px;
    color: white;
    font-size: 18px;
}

.settings-slider .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 5px;
    height: 6px;
}

.settings-slider .unity-base-slider__dragger {
    width: 20px;
    height: 20px;
    background-color: white;
    border-radius: 10px;
    border-width: 0;
}

.settings-slider:hover .unity-base-slider__dragger {
    background-color: #00C8FF; /* Cyan */
    scale: 1.1;
}

/* Dropdown Styling */
.settings-dropdown {
    margin-bottom: 15px;
    font-size: 18px;
    color: white;
}

.settings-dropdown .unity-base-field__label {
    min-width: 150px;
}

.settings-dropdown .unity-base-popup-field__input {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    color: white;
}

/* Toggle Styling */
.settings-toggle {
    margin-bottom: 15px;
    color: white;
    font-size: 18px;
}

.settings-toggle .unity-toggle__checkmark {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    width: 24px;
    height: 24px;
}

.settings-toggle:checked .unity-toggle__checkmark {
    background-color: #00C8FF;
    border-width: 0;
}
