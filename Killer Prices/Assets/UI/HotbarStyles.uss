.hotbar-container {
    position: absolute;
    bottom: 20px;
    width: 100%;
    height: 100px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.slot {
    width: 64px;
    height: 64px;
    margin: 5px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 2px;
    border-color: #555;
    border-radius: 5px;
    justify-content: center;
    align-items: center;
}

.slot.selected {
    border-color: #ffd700; /* Złoty dla wybranego */
    background-color: rgba(50, 50, 50, 0.7);
    scale: 1.1;
}

.slot-icon {
    width: 80%;
    height: 80%;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-number {
    position: absolute;
    top: 2px;
    left: 2px;
    font-size: 12px;
    color: #fff;
}
