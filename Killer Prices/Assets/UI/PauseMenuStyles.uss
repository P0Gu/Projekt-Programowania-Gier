.pause-container {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.85); /* Darker overlay for pause */
}

.pause-panel {
    width: 400px;
    background-color: rgba(30, 30, 30, 0.95);
    border-radius: 20px;
    border-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    padding: 30px;
    align-items: center;
}

.pause-title {
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 30px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
}

.pause-button {
    width: 100%;
    height: 50px;
    margin-bottom: 15px;
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    transition: all 0.2s ease-out;
}

.pause-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
    scale: 1.02;
}

.pause-button:active {
    background-color: rgba(255, 255, 255, 0.05);
    scale: 0.98;
}

.quit-button {
    background-color: rgba(255, 50, 50, 0.2);
    margin-top: 10px;
}

.quit-button:hover {
    background-color: rgba(255, 50, 50, 0.4);
}
