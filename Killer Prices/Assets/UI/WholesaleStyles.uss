/* Main Container - Glassmorphism */
.wholesale-container {
    position: absolute;
    width: 80%;
    height: 80%;
    /* Center */
    top: 10%;
    left: 10%;
    
    background-color: rgba(20, 20, 30, 0.85); /* Dark semi-transparent */
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    
    padding: 20px;
    
    /* Flex Layout */
    display: flex;
    flex-direction: column;
}

/* Header & Tabs */
.header-row {
    flex-direction: row;
    /* justify-content: space-between; <-- REMOVED */
    align-items: center;
    height: 60px;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    picking-mode: ignore; 
}

.title-label {
    font-size: 32px;
    color: white;
    -unity-font-style: bold;
    picking-mode: ignore;
    flex-grow: 1; /* Allow taking space to push button */
    margin-right: auto; /* Push subsequent elements to right? No, flex-grow does it better if width is unset. Let's use flex-grow 1 on a spacer or just margin-right auto on this if container is default. */
    /* Actually for 'push against right wall' in row:
       Label: margin-right: auto; -> Pushes Button to far right.
       Label: flex-grow: 1; -> Pushes Button to far right.
    */
    margin-right: auto; 
    flex-grow: 0;
}

.close-button {
    width: 40px;
    height: 40px;
    background-color: rgba(255, 0, 0, 0.6);
    border-radius: 10px;
    color: white;
    font-size: 24px;
    border-width: 0;
    picking-mode: position; /* Ensure clickable */
    transition: 0.1s;
}

.close-button:hover {
    background-color: blue;
}

/* Tabs */
.tabs-container {
    flex-direction: row;
    height: 50px;
    margin-bottom: 20px;
}

.tab-button {
    flex: 1;
    margin-right: 10px;
    background-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.5); /* Dimmed text */
    border-radius: 10px;
    font-size: 18px;
    -unity-text-align: middle-center;
    transition: 0.2s;
    border-width: 0;
}

.tab-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.tab-button.active {
    background-color: rgba(0, 200, 255, 0.8); /* Cyan Active */
    color: white;
}

/* Item Grid */
.product-list {
    flex-grow: 1;
    margin-top: 10px;
}

/* Fix for ScrollView Wrapping */
.product-list .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center; /* Center items for better look */
}

/* Item Card */
.item-card {
    width: 200px;
    height: 260px;
    margin: 10px;
    background-color: rgba(255, 255, 255, 0.05); /* Very transparent */
    border-radius: 15px;
    padding: 10px;
    align-items: center;
    justify-content: space-between;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}

.item-card:hover {
    background-color: rgba(255, 255, 255, 0.1);
    scale: 1.02;
}

.item-icon {
    width: 120px;
    height: 120px;
    margin-top: 10px;
    background-color: rgba(0,0,0,0.2); /* Darker slot background */
    border-radius: 10px;
}

.item-name {
    font-size: 18px;
    color: white;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.item-price {
    font-size: 16px;
    color: #4CAF50; /* Green */
}

.buy-button {
    width: 100%;
    height: 40px;
    background-color: #4CAF50;
    border-radius: 8px;
    color: white;
    font-size: 16px;
    border-width: 0;
}

.buy-button:hover {
    background-color: #45a049;
}

.buy-button:active {
    background-color: #3e8e41;
}

/* Locked Items Styling */
.item-card.locked {
    opacity: 0.6;
    background-color: rgba(20, 20, 20, 0.9);
}

.item-card.locked .buy-button {
    background-color: #555;
    color: #aaa;
}

.locked-label {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    color: red;
    font-size: 24px;
    -unity-font-style: bold;
    rotate: -15deg;
    text-shadow: 2px 2px 0px black;
}
